# Copy to deploy/.env (never commit .env) and fill in.
# Secret key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
# Secure-only session/CSRF cookies (needed behind the HTTPS tunnel). Use http://localhost:8000 locally.
# Set to 0 only for a browser that refuses Secure cookies on plain http (e.g. Safari on localhost).
DJANGO_SECURE_COOKIES=1
POSTGRES_PASSWORD=change-me
# Agent token: python -c "import secrets, hashlib; t = secrets.token_urlsafe(32); print('TOKEN (give to agents):', t); print('AGENT_TOKEN_SHA256=' + hashlib.sha256(t.encode()).hexdigest())"
AGENT_TOKEN_SHA256=
TIME_ZONE=Asia/Kolkata

# Google sign-in for customers: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URIs: http://localhost:8000/accounts/google/login/callback/ and https://app.<domain>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay: Dashboard → Account & Settings → API Keys (use Test Mode keys while developing).
# Webhook: Dashboard → Webhooks → URL https://<public host>/payments/razorpay/webhook, event payment.captured,
# and a secret of your choice, copied below. Payment capture must be set to Automatic.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

